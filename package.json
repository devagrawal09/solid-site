{
  "name": "solid-site",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.11.2"
  },
  "type": "module",
  "scripts": {
    "build": "run-s type:check test:experiments build:vite build:postoptimize",
    "preview": "vite preview",
    "https-preview": "vite build && serve dist",
    "dev": "vite",
    "build:vite": "vite build",
    "build:postoptimize": "node ./postoptimize.mjs",
    "build:sitemap": "jiti scripts/generateSitemap.js",
    "type:check": "tsc --noEmit",
    "format": "prettier -w \"src/**/*.{js,ts,json,css,tsx,jsx}\" \"src/content/**/*.{md,mdx}\" \"packages/**/*.{ts,json}\" \"tests/**/*.ts\" \"*.{js,ts,mjs,json,yaml,md}\" \"public/examples/*.json\" \"server/**/*.ts\" \"db/**/*.ts\" \"scripts/vite/*.ts\"",
    "deploy:dev": "wrangler publish --env development",
    "deploy:prod": "wrangler publish --env production",
    "format:check": "prettier --check \"src/**/*.{js,ts,json,css,tsx,jsx}\" \"src/content/**/*.{md,mdx}\" \"packages/**/*.{ts,json}\" \"tests/**/*.ts\" \"*.{js,ts,mjs,json,yaml,md}\" \"public/examples/*.json\" \"server/**/*.ts\" \"db/**/*.ts\" \"scripts/vite/*.ts\"",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "test:experiments": "node --import tsx --test tests/experiments.test.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.3",
    "@solid-primitives/event-listener": "3.0.0-next.9",
    "@solid-primitives/i18n": "3.0.0-next.6",
    "@solid-primitives/intersection-observer": "3.0.0-next.5",
    "@solid-primitives/scheduled": "2.0.0-next.4",
    "@solid-primitives/storage": "5.0.0-next.7",
    "@solid-primitives/transition-group": "2.0.0-next.4",
    "@solid-primitives/utils": "7.0.0-next.7",
    "@solid-site/docs-jsx": "link:./packages/docs-jsx",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.42",
    "@solidjs/signals": "2.0.0-rc.18",
    "@solidjs/web": "2.0.0-rc.18",
    "@types/shopify-buy": "npm:@brandboostinggmbh/shopify-buy-types@^2.14.6",
    "drizzle-orm": "0.45.2",
    "fuse.js": "^7.1.0",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.9.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "scroll-behavior-polyfill": "^2.0.13",
    "shopify-buy": "^3.0.0",
    "solid-js": "2.0.0-rc.18",
    "solid-repl": "github:devagrawal09/solid-playground#2b803dd675d63ca2e4b07a57dfce43c0dcfd4e5c&path:/packages/solid-repl"
  },
  "devDependencies": {
    "@aminya/minijson": "^1.1.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@mdx-js/rollup": "^3.0.1",
    "@playwright/test": "1.64.1",
    "@solidjs/h": "2.0.0-rc.0",
    "@solidjs/html": "2.0.0-rc.0",
    "@solidjs/vite-plugin": "3.0.0-next.51",
    "@tailwindcss/typography": "^0.5.10",
    "@types/markdown-it": "^13.0.7",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.4.5",
    "drizzle-kit": "0.31.10",
    "eslint": "^8.57.0",
    "fast-glob": "^3.3.2",
    "front-matter": "^4.0.2",
    "globby": "^14.0.1",
    "got": "^14.2.1",
    "htmlnano": "^2.1.0",
    "https-localhost": "^4.7.1",
    "jiti": "^1.21.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "svgo": "^3.2.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-dir": "^4.0.0",
    "tailwindcss-rtl": "^0.9.0",
    "terser-config-atomic": "^1.0.0",
    "tsx": "4.21.0",
    "typescript": "^5.9.2",
    "vite": "8.3.5",
    "wrangler": "4.92.0"
  },
  "packageManager": "pnpm@12.11.2"
}
